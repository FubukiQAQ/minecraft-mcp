{
  "name": "mcpbridge-server",
  "version": "0.1.0",
  "description": "MCP server that bridges AI clients (Claude Desktop / Cursor ...) to a live Minecraft world through the in-game Fabric mod.",
  "type": "module",
  "bin": {
    "mcpbridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
